# OpenAI is used only for fallback classification and technical investigation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Leave blank for local Laya; otherwise point to the root of laya-serve.
LAYA_BASE_URL=
# Optional custom resident batch adapter; takes precedence over LAYA_BASE_URL.
LAYA_BATCH_BASE_URL=
LAYA_API_KEY=
LAYA_DEVICE=cpu
LAYA_THREADS=4
# Optional: reuse a downloaded checkpoint, e.g. set HF_HOME to an existing cache.
